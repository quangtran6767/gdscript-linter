{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gdguard",
          "version": "<version>",
          "informationUri": "https://github.com/GDQuest/GDScript-formatter",
          "rules": [
            {
              "id": "comparison-with-itself",
              "shortDescription": {
                "text": "Comparing an expression with itself is always true or always false."
              },
              "fullDescription": {
                "text": "`x == x` or `x != x` has a fixed result, so it is almost always a typo for a comparison with another value."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "duplicated-load",
              "shortDescription": {
                "text": "The same resource path is loaded more than once in a file."
              },
              "fullDescription": {
                "text": "Loading the same path in several places repeats the string and makes renames error-prone. Load it once into a constant and reuse it."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "enum-member-name",
              "shortDescription": {
                "text": "Enum members use CONSTANT_CASE."
              },
              "fullDescription": {
                "text": "Enum members are constants, so the GDScript style guide names them in CONSTANT_CASE."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "enum-name",
              "shortDescription": {
                "text": "Enum names use PascalCase."
              },
              "fullDescription": {
                "text": "Enums are types, so the GDScript style guide names them in PascalCase like classes."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "function-name",
              "shortDescription": {
                "text": "Functions use snake_case (or _private_snake_case)."
              },
              "fullDescription": {
                "text": "The GDScript style guide names functions in snake_case, like Godot's own API. A leading underscore marks private functions and virtual callbacks."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "loop-variable-name",
              "shortDescription": {
                "text": "Loop variables use snake_case."
              },
              "fullDescription": {
                "text": "Loop variables are variables, so the GDScript style guide names them in snake_case."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "max-line-length",
              "shortDescription": {
                "text": "Lines are no longer than the configured maximum (100 by default)."
              },
              "fullDescription": {
                "text": "Long lines are hard to read side by side and in diffs. The limit comes from `max-line-length.max` in gdguard.toml, then `max_line_length` in .editorconfig, then 100."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "no-else-return",
              "shortDescription": {
                "text": "No `else`/`elif` after an `if` block that ends with `return`."
              },
              "fullDescription": {
                "text": "When the `if` branch returns, the code after it only runs in the other case anyway. Removing the `else` reduces nesting."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": true,
                "origin": "builtin"
              }
            },
            {
              "id": "no-get-node-in-process",
              "shortDescription": {
                "text": "Don't look up nodes in `$FUNC()`; cache the node in an `@onready` variable"
              },
              "fullDescription": {
                "text": "`_process()` and `_physics_process()` run every frame. Looking a node up by\npath each time costs time and hides the dependency. An `@onready` variable\nlooks it up once, when the node is ready, and documents what the script\nneeds. Unique names (`%Name`) are cached by Godot and are not reported.\nThere is no automatic fix: the variable has to be added at the top of the\nscript, which is outside the reported code."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": false,
                "origin": "custom"
              }
            },
            {
              "id": "prefer-is-empty",
              "shortDescription": {
                "text": "Use `$X.is_empty()` instead of comparing `len($X)` to zero"
              },
              "fullDescription": {
                "text": "Comparing `len()` to zero hides the intent of the check. `is_empty()` reads\nas a question about the collection and doesn't count its elements.\nSee also `prefer-not-is-empty` for `len(x) > 0` and `len(x) != 0`."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": true,
                "origin": "custom"
              }
            },
            {
              "id": "prefer-not-is-empty",
              "shortDescription": {
                "text": "Use `not $X.is_empty()` instead of comparing `len($X)` to zero"
              },
              "fullDescription": {
                "text": "`len(x) > 0` and `len(x) != 0` ask whether a collection has elements by\ncounting them. `not x.is_empty()` asks the question directly.\nThis is the counterpart of `prefer-is-empty`; a rule has one fix template,\nso the two checks are separate rules."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": true,
                "origin": "custom"
              }
            },
            {
              "id": "private-access",
              "shortDescription": {
                "text": "Members starting with `_` are not used from outside their class."
              },
              "fullDescription": {
                "text": "A leading underscore marks a member as private. Using it from another object couples the two classes to internals that may change."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "signal-name",
              "shortDescription": {
                "text": "Signals use snake_case."
              },
              "fullDescription": {
                "text": "The GDScript style guide names signals in snake_case, usually in the past tense, like Godot's built-in signals."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "standalone-expression",
              "shortDescription": {
                "text": "Expressions on their own line have an effect."
              },
              "fullDescription": {
                "text": "A line like `score + 1` computes a value and throws it away. It is usually a mistake for `score += 1` or a leftover."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            },
            {
              "id": "unnecessary-pass",
              "shortDescription": {
                "text": "No `pass` in a block that has other statements."
              },
              "fullDescription": {
                "text": "`pass` only exists to fill an empty block. Next to other statements it does nothing."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": true,
                "origin": "builtin"
              }
            },
            {
              "id": "unused-argument",
              "shortDescription": {
                "text": "Function arguments are used, or start with `_`."
              },
              "fullDescription": {
                "text": "An unused argument is often a bug or a leftover. When the signature must stay (callbacks, overrides), prefix the name with `_` to say so."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "fixable": true,
                "origin": "builtin"
              }
            },
            {
              "id": "variable-name",
              "shortDescription": {
                "text": "Variables use snake_case (or _private_snake_case)."
              },
              "fullDescription": {
                "text": "The GDScript style guide names variables in snake_case. A leading underscore marks private variables."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "fixable": false,
                "origin": "builtin"
              }
            }
          ]
        }
      },
