[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7

[libraries]
linux.debug.x86_64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.so"
linux.release.x86_64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.so"
linux.debug.arm64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.so"
linux.release.arm64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.so"
macos.debug.x86_64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.dylib"
macos.release.x86_64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.dylib"
macos.debug.arm64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.dylib"
macos.release.arm64 = "res://addons/gdguard_standalone/bin/libgdguard_gdextension.dylib"
windows.debug.x86_64 = "res://addons/gdguard_standalone/bin/gdguard_gdextension.dll"
windows.release.x86_64 = "res://addons/gdguard_standalone/bin/gdguard_gdextension.dll"
windows.debug.arm64 = "res://addons/gdguard_standalone/bin/gdguard_gdextension.dll"
windows.release.arm64 = "res://addons/gdguard_standalone/bin/gdguard_gdextension.dll"
